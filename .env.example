# ---- AI providers (server only) ----
ANTHROPIC_API_KEY=
# Claude Code on the web reserves ANTHROPIC_API_KEY for its own auth, so a value
# set there never reaches the session. The author adapter reads this name first.
ANTHROPIC_AUTHOR_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET_KEY=
APIFY_TOKEN=

# ---- Supabase ----
# The two NEXT_PUBLIC_ values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role bypasses RLS. Server only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Inngest ----
# Not needed for `inngest-cli dev`; required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
