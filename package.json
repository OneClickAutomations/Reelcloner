{
  "name": "reelcloner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 next dev",
    "build": "next build",
    "start": "NODE_USE_ENV_PROXY=1 next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "inngest": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "db:test": "bash supabase/tests/run.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "NODE_USE_ENV_PROXY=1 tsx scripts/analyze.ts",
    "db:check": "NODE_USE_ENV_PROXY=1 tsx scripts/db-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@google/genai": "^2.19.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "inngest": "^3.44.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "inngest-cli": "^1.13.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "inngest-cli",
      "protobufjs",
      "unrs-resolver",
      "sharp"
    ]
  }
